# ---------------------------------------------------------------------------
# Biz360 SME ERP frontend — environment template. Copy to `.env` and fill in.
#
# Which variables are SAFE to expose to the browser (NEXT_PUBLIC_*) vs
# server-only is critical. Rule of thumb: if it contains a secret, an internal
# URL, or anything that would help an attacker, it must NOT have the
# NEXT_PUBLIC_ prefix — it belongs in API_BASE_URL (server-only, route handlers
# only) and is never inlined into the bundle.
# ---------------------------------------------------------------------------

# --- API base URL (browser) -------------------------------------------------
# Public because the browser must talk to the backend directly for data calls.
# Must be the origin the backend CORS allowlist actually accepts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# If the backend is served from a different origin than the web app, that
# origin is added to connect-src in the Content-Security-Policy. Derive it from
# NEXT_PUBLIC_API_BASE_URL and set it explicitly here if needed:
# NEXT_PUBLIC_API_CSP_ORIGIN=

# --- API base URL (server-only) --------------------------------------------
# Used by the Next.js route handlers that proxy auth (login/refresh/logout) so
# the refresh token lives in an httpOnly cookie and never reaches the browser.
# This must be the origin the backend responds from (no CORS applies here).
API_BASE_URL=http://localhost:3000

# --- Auth cookies -----------------------------------------------------------
# Identifiers only — NOT secrets. Bind cookies to the app origin so browsers
# scoping them narrowly is a cheap additional guard.
AUTH_REFRESH_COOKIE=erp_refresh
AUTH_SESSION_COOKIE=erp_session
# Comma-separated list of origins allowed to make posted financial changes.
CSP_FRAME_ANCESTORS=none

# --- Dev only ---------------------------------------------------------------
# The frontend dev server port (backend occupies 3000 by default).
# Set PORT=3001 for `next dev`/`next start`.
NEXT_PUBLIC_NODE_ENV=development

# --- End-to-end tests (Playwright) -----------------------------------------
# The unauthenticated redirect and security-header specs run without a backend.
# The role-guard and duplicate-submission specs need a running API and seeded
# users; they are skipped automatically when these are blank.
E2E_BASE_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=