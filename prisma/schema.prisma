// --------------------------------- Banking -----------------------------------

/// Bank / mobile money account for reconciliation.
model BankAccount {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  accountType    BankAccountType @default(BANK)
  accountCode    String?
  bankName       String?
  accountNumber  String?
  openingBalance Decimal         @default(0) @db.Decimal(18, 2)
  currentBalance Decimal         @default(0) @db.Decimal(18, 2)
  active         Boolean         @default(true)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  reconciliations BankReconciliation[]
  statementLines  BankStatementLine[]

  @@unique([organizationId, accountCode])
  @@index([organizationId])
  @@map("bank_accounts")
}

/// Bank statement line imported for reconciliation.
model BankStatementLine {
  id               String              @id @default(uuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
