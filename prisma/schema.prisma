  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ----------------- Compliance: supplier eTIMS capture -----------------------

enum SupplierEtimsCaptureMethod {
  MANUAL
  OCR_SCAN
  SUPPLIER_PORTAL_SYNC
  BULK_IMPORT
}

enum SupplierEtimsMatchStatus {
  UNMATCHED
  MATCHED
  DISPUTED
  MISSING_CONFIRMED
}

enum SupplierEtimsVerificationStatus {
  UNVERIFIED
  VERIFIED_VIA_KRA_QR
  VERIFICATION_FAILED
}

enum ExpenseComplianceFlagType {
  NO_ETIMS_MATCH
  PARTIAL_AMOUNT_MISMATCH
  EXPIRED_MATCH_WINDOW
}

/// A supplier eTIMS receipt captured so it can be matched against a purchase.
/// An expense is only tax-deductible once its purchase is backed by one of
/// these (KRA cross-validates returns against eTIMS records from 2025 YOI).
model SupplierEtimsInvoice {
  id                       String                          @id @default(uuid())
  organizationId           String
  organization             Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId               String
  supplier                 Party                           @relation(fields: [supplierId], references: [id])
  kraInvoiceNumber         String
  kraControlUnitId         String?
  kraQrCodeData            String?
  invoiceDate              DateTime
  amount                   Decimal                         @default(0) @db.Decimal(18, 2)
  vatAmount                Decimal                         @default(0) @db.Decimal(18, 2)
  captureMethod            SupplierEtimsCaptureMethod      @default(MANUAL)
  matchedPurchaseInvoiceId String?
  matchedPurchaseInvoice   PurchaseInvoice?                @relation(fields: [matchedPurchaseInvoiceId], references: [id], onDelete: SetNull)
  matchStatus              SupplierEtimsMatchStatus        @default(UNMATCHED)
  verificationStatus       SupplierEtimsVerificationStatus @default(UNVERIFIED)
  attachmentUrl            String?
  ocrJobId                 String?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  deletedAt                DateTime?

  uploadItems              SupplierEtimsUploadItem[]
  supplierEtimsCreditNotes SupplierEtimsCreditNote[]

  @@index([organizationId])
  @@index([organizationId, matchStatus])
  @@index([organizationId, supplierId])
  @@index([organizationId, invoiceDate])
  @@map("supplier_etims_invoices")
}

/// A KRA credit note (ETCR) issued by a supplier against a previously captured
/// eTIMS invoice — a returned purchase reverses the deductible expense and, when
/// a payment was already withheld, offsets the withholding to remit.
model SupplierEtimsCreditNote {
  id                        String                          @id @default(uuid())
  organizationId            String
  organization              Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId                String
  supplier                  Party                           @relation(fields: [supplierId], references: [id])
  kraInvoiceNumber          String
  originalInvoiceNumber     String?
  originalEtimsInvoiceId    String?
  originalEtimsInvoice      SupplierEtimsInvoice?           @relation(fields: [originalEtimsInvoiceId], references: [id], onDelete: SetNull)
  originalPurchaseInvoiceId String?
  originalPurchaseInvoice   PurchaseInvoice?                @relation(fields: [originalPurchaseInvoiceId], references: [id], onDelete: SetNull)
  creditNoteDate            DateTime
  amount                    Decimal                         @default(0) @db.Decimal(18, 2)
  vatAmount                 Decimal                         @default(0) @db.Decimal(18, 2)
  totalAmount               Decimal                         @default(0) @db.Decimal(18, 2)
  reason                    String?
  captureMethod             SupplierEtimsCaptureMethod      @default(MANUAL)
  matchStatus               SupplierEtimsMatchStatus        @default(UNMATCHED)
  verificationStatus        SupplierEtimsVerificationStatus @default(UNVERIFIED)
  kraQrCodeData             String?
  attachmentUrl             String?
  whtOffsetAmount           Decimal?                        @db.Decimal(18, 2)
  whtOffsetDeductionId      String?
  whtOffsetDeduction        WithholdingTaxDeduction?        @relation(fields: [whtOffsetDeductionId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  deletedAt                 DateTime?

  @@index([organizationId])
  @@index([organizationId, matchStatus])
  @@index([organizationId, supplierId])
  @@index([organizationId, creditNoteDate])
  @@index([organizationId, originalEtimsInvoiceId])
  @@index([organizationId, originalPurchaseInvoiceId])
  @@index([organizationId, whtOffsetDeductionId])
  @@map("supplier_etims_credit_notes")
}

enum SupplierEtimsUploadStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum SupplierEtimsUploadItemStatus {
  QUEUED
  PROCESSED
  DUPLICATE
  ERROR
}

/// A bulk KRA eTIMS Returns (ETR) XML file uploaded so its supplier invoices
/// can be reconciled into the ledger. Rows are queued and materialized by the
/// outbox so large returns files don't block the request.
model SupplierEtimsUpload {
  id             String                    @id @default(uuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  filename       String
  variant        String                    @default("ETR")
  period         String?
  totalItems     Int                       @default(0)
  processedItems Int                       @default(0)
  status         SupplierEtimsUploadStatus @default(UPLOADED)
  errorSummary   String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  items SupplierEtimsUploadItem[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("supplier_etims_uploads")
}

model SupplierEtimsUploadItem {
  id                            String                        @id @default(uuid())
  organizationId                String
  organization                  Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadId                      String
  upload                        SupplierEtimsUpload           @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  rowIndex                      Int
  supplierTin                   String?
  supplierName                  String?
  kraInvoiceNumber              String?
  invoiceDate                   DateTime?
  amount                        Decimal?                      @db.Decimal(18, 2)
  vatAmount                     Decimal?                      @db.Decimal(18, 2)
  rawRecord                     String?
  status                        SupplierEtimsUploadItemStatus @default(QUEUED)
  error                         String?
  createdSupplierEtimsInvoiceId String?
  createdSupplierEtimsInvoice   SupplierEtimsInvoice?         @relation(fields: [createdSupplierEtimsInvoiceId], references: [id], onDelete: SetNull)
  createdAt                     DateTime                      @default(now())
  processedAt                   DateTime?

  @@index([uploadId])
  @@index([organizationId, status])
  @@index([organizationId, supplierTin])
  @@map("supplier_etims_upload_items")
}

/// Accounts-payable compliance exposure. Created automatically for purchases
/// that have no matched supplier eTIMS invoice, so owners can see "at-risk"
/// spend instead of discovering it at year-end.
model ExpenseComplianceFlag {
  id                String                    @id @default(uuid())
  organizationId    String
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice           @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  flagType          ExpenseComplianceFlagType
  amountMismatch    Decimal?                  @db.Decimal(18, 2)
  resolvedAt        DateTime?
  resolutionNote    String?
  createdAt         DateTime                  @default(now())

  @@index([organizationId, flagType])
  @@index([organizationId, purchaseInvoiceId])
  @@index([purchaseInvoiceId])
  @@map("expense_compliance_flags")
}

// --------------------------- Withholding tax ---------------------------------

enum WithholdingTaxPaymentType {
  PROFESSIONAL_FEES
  RENT
  COMMISSION
  ROYALTY
  DIVIDEND
  INTEREST
  CONTRACTUAL_FEES
  OTHER
}

enum WithholdingTaxResidency {
  RESIDENT
  NON_RESIDENT
}

enum WithholdingTaxDeductionStatus {
  CALCULATED
  DEDUCTED
  CERTIFICATE_GENERATED
  REMITTED
}

/// Versioned WHT rate table. `organizationId` is null for KRA system defaults
/// (5-30% depending on payment type/residency); tenants may override.
model WithholdingTaxRate {
  id             String                    @id @default(uuid())
  organizationId String?
  organization   Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentType    WithholdingTaxPaymentType
  residency      WithholdingTaxResidency   @default(RESIDENT)
  ratePercent    Decimal                   @db.Decimal(5, 2)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  updatedAt      DateTime                  @updatedAt

  @@index([organizationId, paymentType, residency, effectiveFrom])
  @@map("withholding_tax_rates")
}

model WithholdingTaxDeduction {
  id                      String                        @id @default(uuid())
  organizationId          String
  organization            Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId              String
  supplier                Party                         @relation(fields: [supplierId], references: [id])
  supplierPaymentId       String?
  supplierPayment         Payment?                      @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)
  paymentType             WithholdingTaxPaymentType     @default(PROFESSIONAL_FEES)
  grossAmount             Decimal                       @db.Decimal(18, 2)
  ratePercent             Decimal                       @db.Decimal(5, 2)
  whtAmount               Decimal                       @db.Decimal(18, 2)
  netPayableAmount        Decimal                       @db.Decimal(18, 2)
  kraWhtCertificateNumber String?
  status                  WithholdingTaxDeductionStatus @default(CALCULATED)
  remittanceDate          DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  etimsCreditNotes SupplierEtimsCreditNote[]

  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  @@index([organizationId, createdAt])
  @@map("withholding_tax_deductions")
}

// ----------------------- Turnover Tax (ToT) mode (A3) ------------------------

/// The tax regime a tenant operates under. Turning over to ToT simplifies the
/// accounting surface (no VAT) and computes turnover-based tax per filing period.
enum TaxRegime {
  VAT_STANDARD
  TURNOVER_TAX
  EXEMPT
}

enum TotFilingPeriodStatus {
  PENDING
  PAID
}

/// Tenant-level tax regime. Created lazily; defaults to VAT_STANDARD.
model OrganizationTaxProfile {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRegime      TaxRegime    @default(VAT_STANDARD)
  totRatePercent Decimal      @default(3) @db.Decimal(5, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("organization_tax_profiles")
}

/// A computed ToT filing period. Turnover is aggregated from confirmed sales
/// each time periods are listed, and the amount due paid via mobile money.
model TotFilingPeriod {
  id               String                @id @default(uuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodStart      DateTime
  periodEnd        DateTime
  grossTurnover    Decimal               @default(0) @db.Decimal(18, 2)
  totDue           Decimal               @default(0) @db.Decimal(18, 2)
  paymentStatus    TotFilingPeriodStatus @default(PENDING)
  paymentReference String?
  paidAt           DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId, paymentStatus])
  @@map("tot_filing_periods")
}
