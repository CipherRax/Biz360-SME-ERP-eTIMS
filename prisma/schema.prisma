// ---------------------------------------------------------------------------
// SME ERP + eTIMS API — Prisma schema
// Multi-tenant (organizationId on every business entity). Soft deletes +
// audit columns via a Prisma client extension (see src/prisma).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------- Enums -------------------------------------

enum Role {
  ADMIN
  MANAGER
  ACCOUNTANT
  STAFF
  READ_ONLY
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OutboxEventType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ETIMS_INVOICE_SUBMIT
  ETIMS_CREDIT_NOTE_SUBMIT
  WEBHOOK
  NOTIFICATION
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ----------------------------- Organization --------------------------------

/// Tenant root. Every business entity belongs to exactly one organization.
model Organization {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  taxPin       String?
  contactEmail String?
  contactPhone String?
  currency     String    @default("KES")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  users                   User[]
  settings                OrganizationSetting?
  refreshTokens           RefreshToken[]
  auditLogs               AuditLog[]
  outboxEvents            OutboxEvent[]
  idempotencyKeys         IdempotencyKey[]
  apiKeys                 ApiKey[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  itemCategories          ItemCategory[]
  unitsOfMeasure          UnitOfMeasure[]
  items                   Item[]

  @@map("organizations")
}

model OrganizationSetting {
  id                      String       @id @default(uuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRate                 Decimal      @default(16) @db.Decimal(5, 2)
  currency                String       @default("KES")
  invoiceNumberFormat     String       @default("INV-{YYYY}-{SEQ:6}")
  defaultPaymentTermsDays Int          @default(30)
  financialYearStart      String       @default("01-01")
  smtpConfig              Json?
  backupConfig            Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  deletedAt               DateTime?

  @@index([organizationId])
  @@map("organization_settings")
}

// ------------------------------- Users -------------------------------------

model User {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email           String       @unique
  passwordHash    String
  name            String
  role            Role         @default(STAFF)
  status          UserStatus   @default(PENDING)
  preferences     Json?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]

  @@index([organizationId])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  familyId       String
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([organizationId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ------------------------------- Audit -------------------------------------

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  createdAt      DateTime     @default(now())
  user           User?        @relation(fields: [userId], references: [id])
  userId         String?

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ------------------------------- Outbox ------------------------------------

/// Event-driven dispatch table. External side-effects (eTIMS, email, M-Pesa,
/// webhooks) MUST be written here in-request and consumed by a queue worker —
/// never fired inline. Malformed DB state and external systems stay consistent.
model OutboxEvent {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType      OutboxEventType
  aggregateType  String
  aggregateId    String
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  nextAttemptAt  DateTime          @default(now())
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@index([eventType, aggregateType, aggregateId])
  @@map("outbox_events")
}

// ----------------------------- Idempotency ---------------------------------

/// Dedupes financial-mutation POSTs keyed by the `Idempotency-Key` header.
model IdempotencyKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  method         String
  path           String
  requestHash    String
  responseCode   Int?
  responseBody   Json?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  @@unique([organizationId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ------------------------------ API keys -----------------------------------

/// Machine-to-machine credentials (hashed at rest).
model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String       @unique
  scopes         String[]     @default([])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("api_keys")
}

// ------------------------------ Inventory -----------------------------------

/// Product catalog grouping, e.g. "Beverages" or "Hardware".
model ItemCategory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  active         Boolean      @default(true)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items Item[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("item_categories")
}

/// Reference unit of measure, e.g. "piece" (pcs), "kilogram" (kg), "litre" (l).
model UnitOfMeasure {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  symbol         String
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, symbol])
  @@index([organizationId])
  @@map("units_of_measure")
}

/// Sellable/stockable product. `sku` is unique per organization; `stockOnHand`
/// is denormalized and will be driven by stock movements in the inventory phase.
model Item {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  description    String?
  categoryId     String?
  category       ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  baseUnit       String        @default("pcs")
  buyPrice       Decimal?      @db.Decimal(18, 2)
  sellPrice      Decimal?      @db.Decimal(18, 2)
  // KRA eTIMS VAT/excise classification when invoicing (e.g. "1" = standard).
  taxCode        String?
  stockOnHand    Decimal       @default(0) @db.Decimal(18, 3)
  reorderLevel   Decimal?      @db.Decimal(18, 3)
  active         Boolean       @default(true)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
  @@map("items")
}
