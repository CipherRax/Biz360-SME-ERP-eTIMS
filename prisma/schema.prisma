// ---------------------------------------------------------------------------
// SME ERP + eTIMS API — Prisma schema
// Multi-tenant (organizationId on every business entity). Soft deletes +
// audit columns via a Prisma client extension (see src/prisma).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------- Enums -------------------------------------

enum Role {
  ADMIN
  MANAGER
  ACCOUNTANT
  STAFF
  READ_ONLY
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OutboxEventType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ETIMS_INVOICE_SUBMIT
  ETIMS_CREDIT_NOTE_SUBMIT
  ETIMS_SUPPLIER_OCR
  ETIMS_SUPPLIER_VERIFY
  ETIMS_SUPPLIER_CREDIT_VERIFY
  ETIMS_BULK_IMPORT
  TOT_PAYMENT_STK_PUSH
  WEBHOOK
  NOTIFICATION
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// A counterparty can be a customer, a supplier, or both.
enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum PartyStatus {
  ACTIVE
  INACTIVE
}

/// Sales documents. `INVOICE` is the eTIMS "0" sale; `CREDIT_NOTE` reverses it.
enum InvoiceType {
  INVOICE
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  M_PESA
  BANK_TRANSFER
  CARD
  CHEQUE
}

enum StockMovementType {
  ADJUSTMENT
  PURCHASE_IN
  SALE_OUT
  VOID
}

/// Classification of ledger accounts in the chart of accounts.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// DRAFT = not yet affecting reports; POSTED = live in the ledger; REVERSED =
/// a posted entry that was cancelled (the reversal itself is a POSTED entry).
enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

/// Where an entry came from. Auto-generated entries are immutable and tagged
/// with both `sourceType` and `sourceId` for full audit traceability.
enum JournalSourceType {
  MANUAL
  SALE_INVOICE
  SALE_COGS
  SALE_COGS_REVERSAL
  SALE_PAYMENT
  SALE_PAYMENT_REVERSAL
  SALE_VOID
  PURCHASE_INVOICE
  PURCHASE_PAYMENT
  PURCHASE_PAYMENT_REVERSAL
  PURCHASE_VOID
  REVERSAL
  CREDIT_NOTE
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RECEIVED
  CLOSED
  REJECTED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum BankAccountType {
  BANK
  M_PESA
  CASH
  MOBILE_MONEY
}

enum NotificationType {
  LOW_STOCK
  INVOICE_CONFIRMED
  INVOICE_PAID
  PO_APPROVED
  PO_REJECTED
  PAYMENT_RECEIVED
  SYSTEM
  CUSTOM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

// ----------------------------- Organization --------------------------------

/// Tenant root. Every business entity belongs to exactly one organization.
model Organization {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  taxPin       String?
  contactEmail String?
  contactPhone String?
  currency     String    @default("KES")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  users                    User[]
  settings                 OrganizationSetting?
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  outboxEvents             OutboxEvent[]
  idempotencyKeys          IdempotencyKey[]
  apiKeys                  ApiKey[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  itemCategories           ItemCategory[]
  unitsOfMeasure           UnitOfMeasure[]
  items                    Item[]
  parties                  Party[]
  saleInvoices             SaleInvoice[]
  saleInvoiceLines         SaleInvoiceLine[]
  payments                 Payment[]
  invoiceNumberSeqs        InvoiceNumberSeq[]
  purchaseInvoices         PurchaseInvoice[]
  purchaseInvoiceLines     PurchaseInvoiceLine[]
  purchaseInvoiceSeqs      PurchaseInvoiceSeq[]
  stockMovements           StockMovement[]
  accounts                 Account[]
  journalEntries           JournalEntry[]
  journalEntryLines        JournalEntryLine[]
  journalEntrySeqs         JournalEntrySeq[]
  quotations               Quotation[]
  quotationLines           QuotationLine[]
  quotationNumberSeqs      QuotationNumberSeq[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderLines       PurchaseOrderLine[]
  purchaseOrderNumberSeqs  PurchaseOrderNumberSeq[]
  goodsReceipts            GoodsReceipt[]
  goodsReceiptLines        GoodsReceiptLine[]
  goodsReceiptNumberSeqs   GoodsReceiptNumberSeq[]
  creditNotes              CreditNote[]
  creditNoteLines          CreditNoteLine[]
  creditNoteNumberSeqs     CreditNoteNumberSeq[]
  bankAccounts             BankAccount[]
  bankStatementLines       BankStatementLine[]
  bankReconciliations      BankReconciliation[]
  notifications            Notification[]
  supplierEtimsInvoices    SupplierEtimsInvoice[]
  expenseComplianceFlags   ExpenseComplianceFlag[]
  withholdingTaxRates      WithholdingTaxRate[]
  withholdingTaxDeductions WithholdingTaxDeduction[]
  supplierEtimsCreditNotes SupplierEtimsCreditNote[]
  supplierEtimsUploads     SupplierEtimsUpload[]
  supplierEtimsUploadItems SupplierEtimsUploadItem[]
  taxProfile               OrganizationTaxProfile?
  totFilingPeriods         TotFilingPeriod[]

  @@map("organizations")
}

model OrganizationSetting {
  id                      String       @id @default(uuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRate                 Decimal      @default(16) @db.Decimal(5, 2)
  currency                String       @default("KES")
  invoiceNumberFormat     String       @default("INV-{YYYY}-{SEQ:6}")
  defaultPaymentTermsDays Int          @default(30)
  financialYearStart      String       @default("01-01")
  smtpConfig              Json?
  backupConfig            Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  deletedAt               DateTime?

  @@index([organizationId])
  @@map("organization_settings")
}

// ------------------------------- Users -------------------------------------

model User {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email               String       @unique
  passwordHash        String
  name                String
  avatarUrl           String?
  role                Role         @default(STAFF)
  status              UserStatus   @default(PENDING)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  preferences         Json?
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  createdBy           String?
  updatedBy           String?

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  paymentsReceived        Payment[]

  @@index([organizationId])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  familyId       String
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([organizationId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organizationId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organizationId])
  @@map("password_reset_tokens")
}

// ------------------------------- Audit -------------------------------------

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  createdAt      DateTime     @default(now())
  user           User?        @relation(fields: [userId], references: [id])
  userId         String?

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ------------------------------- Outbox ------------------------------------

/// Event-driven dispatch table. External side-effects (eTIMS, email, M-Pesa,
/// webhooks) MUST be written here in-request and consumed by a queue worker —
/// never fired inline. Malformed DB state and external systems stay consistent.
model OutboxEvent {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType      OutboxEventType
  aggregateType  String
  aggregateId    String
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  nextAttemptAt  DateTime          @default(now())
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@index([eventType, aggregateType, aggregateId])
  @@map("outbox_events")
}

// ----------------------------- Idempotency ---------------------------------

/// Dedupes financial-mutation POSTs keyed by the `Idempotency-Key` header.
model IdempotencyKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  method         String
  path           String
  requestHash    String
  responseCode   Int?
  responseBody   Json?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  @@unique([organizationId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ------------------------------ API keys -----------------------------------

/// Machine-to-machine credentials (hashed at rest).
model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String       @unique
  scopes         String[]     @default([])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("api_keys")
}

// ------------------------------ Inventory -----------------------------------

/// Product catalog grouping, e.g. "Beverages" or "Hardware".
model ItemCategory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  active         Boolean      @default(true)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items Item[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("item_categories")
}

/// Reference unit of measure, e.g. "piece" (pcs), "kilogram" (kg), "litre" (l).
model UnitOfMeasure {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  symbol         String
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, symbol])
  @@index([organizationId])
  @@map("units_of_measure")
}

/// Sellable/stockable product. `sku` is unique per organization; `stockOnHand`
/// is denormalized and will be driven by stock movements in the inventory phase.
model Item {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  description    String?
  categoryId     String?
  category       ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  baseUnit       String        @default("pcs")
  buyPrice       Decimal?      @db.Decimal(18, 2)
  sellPrice      Decimal?      @db.Decimal(18, 2)
  // KRA eTIMS VAT/excise classification when invoicing (e.g. "1" = standard).
  taxCode        String?
  // Services (labour, transport) do not move stock.
  trackStock     Boolean       @default(true)
  stockOnHand    Decimal       @default(0) @db.Decimal(18, 3)
  reorderLevel   Decimal?      @db.Decimal(18, 3)
  active         Boolean       @default(true)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  saleLines          SaleInvoiceLine[]
  purchaseLines      PurchaseInvoiceLine[]
  stockMovements     StockMovement[]
  quotationLines     QuotationLine[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  creditNoteLines    CreditNoteLine[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
  @@map("items")
}

// ------------------------------- Parties -------------------------------------

/// Customer and supplier records (single table, discriminated by `type`).
/// `taxId` is the KRA PIN — the natural key for eTIMS invoicing.
model Party {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type             PartyType    @default(CUSTOMER)
  name             String
  email            String?
  phone            String?
  taxId            String?
  website          String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  country          String       @default("KE")
  postalCode       String?
  creditLimit      Decimal?     @db.Decimal(18, 2)
  paymentTermsDays Int          @default(30)
  notes            String?
  kraPinVerifiedAt DateTime?
  status           PartyStatus  @default(ACTIVE)
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        String?
  updatedBy        String?

  saleInvoices             SaleInvoice[]
  payments                 Payment[]
  purchaseInvoices         PurchaseInvoice[]
  quotations               Quotation[]
  purchaseOrders           PurchaseOrder[]
  goodsReceipts            GoodsReceipt[]
  creditNotes              CreditNote[]
  supplierEtimsInvoices    SupplierEtimsInvoice[]
  withholdingTaxDeductions WithholdingTaxDeduction[]
  supplierEtimsCreditNotes SupplierEtimsCreditNote[]

  @@unique([organizationId, taxId])
  @@index([organizationId])
  @@index([organizationId, type])
  @@map("parties")
}

// -------------------------------- Sales --------------------------------------

/// Financial documents are immutable: they are never hard-deleted. `VOID`
/// reverses a document; stock movements only happen on CONFIRM / VOID.
model SaleInvoice {
  id                     String        @id @default(uuid())
  organizationId         String
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber          String
  type                   InvoiceType   @default(INVOICE)
  partyId                String
  party                  Party         @relation(fields: [partyId], references: [id])
  invoiceDate            DateTime      @default(now())
  dueDate                DateTime?
  status                 InvoiceStatus @default(DRAFT)
  subtotal               Decimal       @default(0) @db.Decimal(18, 2)
  discountTotal          Decimal       @default(0) @db.Decimal(18, 2)
  taxTotal               Decimal       @default(0) @db.Decimal(18, 2)
  total                  Decimal       @default(0) @db.Decimal(18, 2)
  amountPaid             Decimal       @default(0) @db.Decimal(18, 2)
  currency               String        @default("KES")
  notes                  String?
  // eTIMS (KRA) submission results — set by the submission worker.
  etimsCtrlNo            String?
  etimsReceipt           String?
  etimsSubmittedAt       DateTime?
  etimsCreditCtrlNo      String?
  etimsCreditReceipt     String?
  etimsCreditSubmittedAt DateTime?
  voidedAt               DateTime?
  voidReason             String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  createdBy              String?
  updatedBy              String?

  lines       SaleInvoiceLine[]
  payments    Payment[]         @relation("SaleInvoicePayments")
  creditNotes CreditNote[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, partyId])
  @@index([organizationId, invoiceDate])
  @@map("sale_invoices")
}

model SaleInvoiceLine {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        SaleInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId         String?
  item           Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  description    String
  quantity       Decimal      @default(1) @db.Decimal(18, 3)
  unitPrice      Decimal      @default(0) @db.Decimal(18, 2)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2)
  discountPct    Decimal      @default(0) @db.Decimal(5, 2)
  lineDiscount   Decimal      @default(0) @db.Decimal(18, 2)
  lineAmount     Decimal      @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal      @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal      @default(0) @db.Decimal(18, 2)
  sortOrder      Int          @default(0)

  @@index([invoiceId])
  @@index([itemId])
  @@index([organizationId])
  @@map("sale_invoice_lines")
}

/// Receipt / payment — linked to either a sale or purchase invoice (but not both).
model Payment {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partyId           String
  party             Party            @relation(fields: [partyId], references: [id])
  // Link to the sale OR purchase invoice (exactly one set).
  invoiceId         String?
  invoice           SaleInvoice?     @relation("SaleInvoicePayments", fields: [invoiceId], references: [id], onDelete: SetNull)
  purchaseInvoiceId String?
  purchaseInvoice   PurchaseInvoice? @relation("PurchaseInvoicePayments", fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  amount            Decimal          @db.Decimal(18, 2)
  method            PaymentMethod    @default(CASH)
  reference         String?
  paidAt            DateTime         @default(now())
  receivedById      String?
  receivedBy        User?            @relation(fields: [receivedById], references: [id])
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdBy         String?
  updatedBy         String?

  withholdingDeductions WithholdingTaxDeduction[]

  @@index([organizationId, paidAt])
  @@index([partyId])
  @@index([invoiceId])
  @@index([purchaseInvoiceId])
  @@map("payments")
}

/// Per-organization invoice number sequences. The sales service reserves the
/// next number atomically (increment) so numbering is gap-safe and race-free.
model InvoiceNumberSeq {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  value          Int          @default(0)

  @@map("invoice_number_seqs")
}

/// Append-only ledger of stock changes. Positive quantity = stock in,
/// negative = stock out. `referenceId` links to a sale invoice, purchase
/// document, or is null for a manual adjustment.
model StockMovement {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item              @relation(fields: [itemId], references: [id])
  quantity       Decimal           @db.Decimal(18, 3)
  type           StockMovementType
  reason         String?
  referenceId    String?
  userId         String?
  createdAt      DateTime          @default(now())

  @@index([itemId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

// ------------------------------ Purchasing ----------------------------------

/// Supplier bill. Reuses the sales `InvoiceStatus` flow and the `Payment`
/// table (accounts payable). Confirming increments stock (PURCHASE_IN).
model PurchaseInvoice {
  id               String        @id @default(uuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber    String
  supplierRef      String?
  partyId          String
  party            Party         @relation(fields: [partyId], references: [id])
  invoiceDate      DateTime      @default(now())
  dueDate          DateTime?
  status           InvoiceStatus @default(DRAFT)
  subtotal         Decimal       @default(0) @db.Decimal(18, 2)
  discountTotal    Decimal       @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal       @default(0) @db.Decimal(18, 2)
  total            Decimal       @default(0) @db.Decimal(18, 2)
  amountPaid       Decimal       @default(0) @db.Decimal(18, 2)
  currency         String        @default("KES")
  notes            String?
  // eTIMS (KRA) received-invoice results — set by the submission worker.
  etimsCtrlNo      String?
  etimsReceipt     String?
  etimsSubmittedAt DateTime?
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        String?
  updatedBy        String?

  lines                    PurchaseInvoiceLine[]
  payments                 Payment[]                 @relation("PurchaseInvoicePayments")
  supplierEtimsInvoices    SupplierEtimsInvoice[]
  supplierEtimsCreditNotes SupplierEtimsCreditNote[]
  expenseComplianceFlags   ExpenseComplianceFlag[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, partyId])
  @@index([organizationId, invoiceDate])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId         String?
  item           Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  description    String
  quantity       Decimal         @default(1) @db.Decimal(18, 3)
  unitPrice      Decimal         @default(0) @db.Decimal(18, 2)
  taxRate        Decimal         @default(0) @db.Decimal(5, 2)
  discountPct    Decimal         @default(0) @db.Decimal(5, 2)
  lineDiscount   Decimal         @default(0) @db.Decimal(18, 2)
  lineAmount     Decimal         @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal         @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(18, 2)
  sortOrder      Int             @default(0)

  @@index([invoiceId])
  @@index([itemId])
  @@index([organizationId])
  @@map("purchase_invoice_lines")
}

/// Per-organization purchase invoice number sequences.
model PurchaseInvoiceSeq {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  value          Int          @default(0)

  @@map("purchase_invoice_seqs")
}

// ------------------------------ Accounting ----------------------------------

/// Chart of accounts. `type` drives the normal balance side (ASSET/EXPENSE 💸
/// debit, LIABILITY/EQUITY/INCOME credit) and the financial report grouping.
/// Seeded automatically for every tenant at registration.
model Account {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           AccountType
  parentId       String?
  parent         Account?     @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Account[]    @relation("AccountTree")
  description    String?
  active         Boolean      @default(true)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  updatedBy      String?

  journalLines JournalEntryLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentId])
  @@map("accounts")
}

/// General ledger entry. Double-entry: every entry is a balanced set of
/// `JournalEntryLine`s (enforced by a DB trigger in the migration). Financial
/// documents are immutable: auto-generated entries are created POSTED and can
/// only be cancelled via a reversing entry.
model JournalEntry {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryNumber    String
  entryDate      DateTime           @default(now())
  status         JournalEntryStatus @default(DRAFT)
  sourceType     JournalSourceType  @default(MANUAL)
  sourceId       String?
  description    String?
  // The POSTED entry this entry reverses (null for normal entries).
  reversalOfId   String?            @unique
  reversalOf     JournalEntry?      @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  // The reversing entry (set on the original once cancelled).
  reversedBy     JournalEntry?      @relation("JournalReversal")
  approvedBy     String?
  approvedAt     DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines JournalEntryLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, status])
  @@index([organizationId, entryDate])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryId        String
  entry          JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(18, 2)
  credit         Decimal      @default(0) @db.Decimal(18, 2)
  memo           String?

  @@index([entryId])
  @@index([accountId])
  @@index([organizationId])
  @@map("journal_entry_lines")
}

/// Per-organization journal entry number sequences (JE-YYYY-XXXXXX).
model JournalEntrySeq {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  value          Int          @default(0)

  @@map("journal_entry_seqs")
}

// ------------------------------- Quotations ----------------------------------

/// A quote to a customer. Can be converted to a sale invoice.
model Quotation {
