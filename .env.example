# ---------------------------------------------------------------------------
# Environment template for sme-erp-api. Copy to `.env` and fill real values.
# The app validates every variable on boot with Joi and fails fast if missing.
#
# PRODUCTION reading order: NODE_ENV=production turns on fail-closed CORS,
# hides Swagger docs, disables pino-pretty and refuses to start without
# trusted CORS origins. It will NOT set a safe default for secrets for you.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# Set NODE_ENV=production when deploying. Swagger is only mounted for
# development/test; production refuses to boot with an empty CORS_ORIGINS.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated list of TRUSTED frontend origins. In production this is
# required — the server starts with CORS "fail closed" if it is empty.
# The Next.js frontend dev server runs on :3001 (`next dev -p 3001`).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5432/erp?schema=public

# --- Redis / queue ---------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Use long random values. Something like:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Prevent accounts being created without verification in production.
EMAIL_VERIFICATION_REQUIRED=true
# Brute-force protection: lock an account after N failed logins for Ms.
AUTH_LOGIN_LOCKOUT_THRESHOLD=10
AUTH_LOGIN_LOCKOUT_MS=900000

# --- Email / SMTP (used by the notification worker) ------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SME ERP <noreply@example.com>"

# --- eTIMS (KRA) integration -----------------------------------------------
# `mock` (default) synthesizes KRA receipts offline; `live` calls the real API.
# For live you must supply the device serial registration + auth credentials
# issued by KRA; the app also requires the organization to have a tax PIN.
ETIMS_MODE=mock
ETIMS_BASE_URL=https://preprod-tims.kra.go.ke
ETIMS_CLIENT_ID=
ETIMS_CLIENT_SECRET=
ETIMS_TAXPAYER_PIN=
ETIMS_DEVICE_SERIAL=
ETIMS_TIMEOUT_MS=10000

# --- Idempotency -----------------------------------------------------------
# How long an Idempotency-Key claim is kept before a replay is rejected.
IDEMPOTENCY_TTL_HOURS=24

# --- Logging ---------------------------------------------------------------
# pino level: info (default), debug, warn, error, silent (tests).
# pino-pretty is only used when NODE_ENV != production.
LOG_LEVEL=info

# --- Outbox worker ---------------------------------------------------------
# Polls enqueued side-effects and dispatches them to handlers with retry/backoff.
# Set OUTBOX_WORKER_ENABLED=false on extra API replicas if you run a single
# dedicated worker instance.
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=10
# Reclaims rows stuck in PROCESSING (crashed worker) after this long.
OUTBOX_STALE_PROCESSING_MS=60000

# --- Rate limiting ---------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100