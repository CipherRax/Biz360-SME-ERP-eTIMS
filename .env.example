# ---------------------------------------------------------------------------
# Environment template for sme-erp-api. Copy to `.env` and fill real values.
# The app validates every variable on boot with Joi and fails fast if missing.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5432/erp?schema=public

# --- Redis / queue ---------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Prevent accounts being created without verification in production.
EMAIL_VERIFICATION_REQUIRED=true

# --- Email / SMTP (used by the notification worker, Phase 5) ---------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SME ERP <noreply@example.com>"

# --- eTIMS (KRA) integration -----------------------------------------------
# `mock` (default) synthesizes KRA receipts offline; `live` calls the real API.
ETIMS_MODE=mock
ETIMS_BASE_URL=https://preprod-tims.kra.go.ke
ETIMS_CLIENT_ID=
ETIMS_CLIENT_SECRET=
ETIMS_TAXPAYER_PIN=
ETIMS_DEVICE_SERIAL=
ETIMS_TIMEOUT_MS=10000

# --- Idempotency -----------------------------------------------------------
# How long an Idempotency-Key claim is kept before a replay is rejected.
IDEMPOTENCY_TTL_HOURS=24

# --- Logging ---------------------------------------------------------------
# pino level: info (default), debug, warn, error, silent (tests).
LOG_LEVEL=info

# --- Outbox worker ---------------------------------------------------------
# Polls enqueued side-effects and dispatches them to handlers with retry/backoff.
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=10

# --- Rate limiting ---------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100