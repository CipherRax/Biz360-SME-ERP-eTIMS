# ---------------------------------------------------------------------------
# Environment template for sme-erp-api. Copy to `.env` and fill real values.
# The app validates every variable on boot with Joi and fails fast if missing.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5432/erp?schema=public

# --- Redis / queue ---------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Prevent accounts being created without verification in production.
EMAIL_VERIFICATION_REQUIRED=true

# --- Email / SMTP (used by the notification worker, Phase 5) ---------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SME ERP <noreply@example.com>"

# --- eTIMS (KRA) integration, Phase 4 --------------------------------------
ETIMS_ENV=sandbox
ETIMS_CERT_PATH=
ETIMS_CERT_PASSPHRASE=

# --- Rate limiting ---------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100